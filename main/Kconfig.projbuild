menu "Desktop"

    config DESKTOP_WIFI_SSID
        string "WiFi SSID"
        default ""

    config DESKTOP_WIFI_PASSWORD
        string "WiFi password"
        default ""

    config DESKTOP_LAT
        string "Weather latitude"
        default "22.5455"

    config DESKTOP_LON
        string "Weather longitude"
        default "114.0683"

    config DESKTOP_MEDIA_HOST
        string "media-web host or IP"
        default "192.168.1.100"

    config DESKTOP_MEDIA_USER
        string "media-web user"
        default ""

    config DESKTOP_MEDIA_PASSWORD
        string "media-web password"
        default ""

    config DESKTOP_OTA_URL
        string "OTA manifest URL (empty = disabled)"
        default ""
        help
            JSON manifest: {"project":"nicemcu-desktop","version":"0.3.1",
            "url":"http://host/app.bin"}

    config DESKTOP_OTA_CHECK_DELAY_S
        int "Seconds after WiFi connect before OTA check"
        default 15
        range 0 600

    config DESKTOP_HTTP_TOKEN
        string "Local HTTP API token (empty = API disabled)"
        default ""

endmenu
